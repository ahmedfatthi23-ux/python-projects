import tkinter as tk
import random

window = tk.Tk()
window.title("Snake Game")

canvas = tk.Canvas(window, width=500, height=500, bg="#9b9b9b")
canvas.pack()

snake = []
direction = "Right"
apple = None
game_over = False


def start_game():
    global snake, direction, apple, game_over

    snake = [(250, 250), (240, 250), (230, 250)]
    direction = "Right"
    game_over = False

    respawn_button.place_forget()
    create_apple()
    draw()
    move()


def create_apple():
    global apple

    apple = (random.randrange(0, 500, 10), random.randrange(0, 500, 10))

    while apple in snake:
        apple = (random.randrange(0, 500, 10), random.randrange(0, 500, 10))


def draw():
    canvas.delete("all")

    # Concrete-like background lines
    for x in range(0, 500, 50):
        canvas.create_line(x, 0, x, 500, fill="#8f8f8f")
    for y in range(0, 500, 50):
        canvas.create_line(0, y, 500, y, fill="#8f8f8f")

    # Apple
    apple_x, apple_y = apple
    canvas.create_oval(apple_x + 1, apple_y + 1, apple_x + 9, apple_y + 9, fill="red", outline="darkred")

    # Snake
    for x, y in snake:
        canvas.create_rectangle(x, y, x + 10, y + 10, fill="green", outline="darkgreen")


def move():
    global game_over

    if game_over:
        return

    head_x, head_y = snake[0]

    if direction == "Right":
        head_x += 10
    elif direction == "Left":
        head_x -= 10
    elif direction == "Up":
        head_y -= 10
    elif direction == "Down":
        head_y += 10

    new_head = (head_x, head_y)

    # Hit the wall or yourself
    if (head_x < 0 or head_x >= 500 or
            head_y < 0 or head_y >= 500 or
            new_head in snake):
        die()
        return

    snake.insert(0, new_head)

    if new_head == apple:
        create_apple()
    else:
        snake.pop()

    draw()
    window.after(100, move)


def change_direction(event):
    global direction

    if event.keysym == "Up" and direction != "Down":
        direction = "Up"
    elif event.keysym == "Down" and direction != "Up":
        direction = "Down"
    elif event.keysym == "Left" and direction != "Right":
        direction = "Left"
    elif event.keysym == "Right" and direction != "Left":
        direction = "Right"


def die():
    global game_over
    game_over = True

    canvas.create_rectangle(130, 190, 370, 310, fill="#555555", outline="white")
    canvas.create_text(250, 225, text="YOU DIED", fill="white", font=("Arial", 28, "bold"))
    canvas.create_text(250, 265, text="Press Respawn to play again", fill="white", font=("Arial", 12))

    respawn_button.place(x=205, y=285)


respawn_button = tk.Button(window, text="Respawn", command=start_game, font=("Arial", 12, "bold"))

window.bind("<KeyPress>", change_direction)

start_game()

window.mainloop()
